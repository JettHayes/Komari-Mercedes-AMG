{
    "name": "Komari Mercedes-AMG",
    "short": "amg-race-control",
    "description": "Mercedes-AMG PETRONAS F1 Race Control 风格的 Komari 监控主题 / Mercedes-AMG PETRONAS F1 Race Control theme for Komari Monitor",
    "version": "1.0.1",
    "author": "Jett Hayes",
    "url": "https://github.com/JettHayes/Komari-Mercedes-AMG",
    "preview": "dist/assets/theme-preview.png",
    "configuration": {
        "type": "managed",
        "icon": "Palette",
        "name": {
            "zh-CN": "主题设置",
            "en": "Theme Settings"
        },
        "data": [
            {
                "type": "title",
                "name": {
                    "zh-CN": "基础设置",
                    "en": "General"
                }
            },
            {
                "key": "showRamDiskTotal",
                "type": "switch",
                "name": {
                    "zh-CN": "显示总内存和磁盘",
                    "zh-TW": "顯示總記憶體和磁碟",
                    "en": "Show Total RAM and Disk"
                },
                "default": true
            },
            {
                "key": "nodeViewMode",
                "type": "select",
                "name": {
                    "zh-CN": "默认节点视图",
                    "en": "Default Node View"
                },
                "options": "large,grid,table,auto",
                "default": "large"
            },
            {
                "key": "offlineServerPosition",
                "type": "select",
                "name": {
                    "zh-CN": "离线节点位置",
                    "en": "Offline Server Position"
                },
                "options": "First,Keep,Last",
                "default": "Last",
                "help": {
                    "zh-CN": "First：离线靠前；Keep：严格按后台权重；Last：离线靠后（默认，与官方主题一致）",
                    "en": "First: offline first; Keep: weight only; Last: offline last (default, matches official theme)"
                }
            },
            {
                "key": "appearance",
                "type": "select",
                "name": {
                    "zh-CN": "默认外观",
                    "en": "Default Appearance"
                },
                "options": "light,dark",
                "default": "dark"
            },
            {
                "key": "language",
                "type": "select",
                "name": {
                    "zh-CN": "默认语言",
                    "en": "Default Language"
                },
                "options": "auto,en,zh-CN,zh-TW",
                "default": "zh-CN"
            },
            {
                "type": "title",
                "name": {
                    "zh-CN": "概览模块",
                    "en": "Overview Modules"
                }
            },
            {
                "key": "statusCardsVisibility.clock",
                "type": "switch",
                "name": {
                    "zh-CN": "显示系统时间",
                    "en": "Show System Time"
                },
                "default": true
            },
            {
                "key": "statusCardsVisibility.fleetKpi",
                "type": "switch",
                "name": {
                    "zh-CN": "显示集群 KPI",
                    "en": "Show Fleet KPI"
                },
                "default": true
            },
            {
                "key": "statusCardsVisibility.alerts",
                "type": "switch",
                "name": {
                    "zh-CN": "显示告警面板",
                    "en": "Show Alerts"
                },
                "default": true
            },
            {
                "key": "statusCardsVisibility.speedTrend",
                "type": "switch",
                "name": {
                    "zh-CN": "显示网速趋势",
                    "en": "Show Network Pace"
                },
                "default": true
            },
            {
                "key": "statusCardsVisibility.map",
                "type": "switch",
                "name": {
                    "zh-CN": "显示地图",
                    "en": "Show Map View"
                },
                "default": true
            },
            {
                "key": "statusCardsVisibility.region",
                "type": "switch",
                "name": {
                    "zh-CN": "显示地区分布",
                    "en": "Show Region Overview"
                },
                "default": true
            },
            {
                "type": "title",
                "name": {
                    "zh-CN": "游客显示",
                    "zh-TW": "訪客顯示",
                    "en": "Guest Display"
                }
            },
            {
                "key": "guestDisplay.showPrice",
                "type": "switch",
                "name": {
                    "zh-CN": "向游客显示价格",
                    "en": "Show Prices to Guests"
                },
                "default": true
            },
            {
                "key": "guestDisplay.showExpiredAt",
                "type": "switch",
                "name": {
                    "zh-CN": "向游客显示到期时间",
                    "en": "Show Expiration to Guests"
                },
                "default": true
            }
        ]
    }
}
