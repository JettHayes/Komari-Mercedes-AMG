            },
            {
                "key": "statusCardsVisibility.map",
                "type": "bool",
                "label": "Show map view",
                "default": true
            },
            {
                "key": "statusCardsVisibility.region",
                "type": "bool",
                "label": "Show region overview",
                "default": true
            },
            {
                "key": "guestDisplay.showPrice",
                "type": "bool",
                "label": "Show prices to guests",
                "default": false
            },
            {
                "key": "guestDisplay.showExpiredAt",
                "type": "bool",
                "label": "Show expiration to guests",
                "default": false
            }
        ],
