{
    "name": "Komari-Mercedes-AMG",
    "short": "amg-race-control",
    "description": "Mercedes-AMG PETRONAS F1 Race Control theme for Komari Monitor",
    "version": "1.0.0",
    "author": "Jett Hayes",
    "url": "https://github.com/JettHayes/Komari-Mercedes-AMG",
    "preview": "preview.png",
    "configuration": {
        "name": "Theme Settings",
        "icon": "Palette",
        "description": "AMG Race Control theme defaults",
        "managedFields": [
            {
                "key": "showRamDiskTotal",
                "type": "bool",
                "label": "Show total RAM and disk space",
                "default": true
            },
            {
                "key": "nodeViewMode",
                "type": "option",
                "label": "Default node view",
                "options": [
                    "large",
                    "grid",
                    "table",
                    "auto"
                ],
                "default": "large"
            },
            {
                "key": "appearance",
                "type": "option",
                "label": "Default appearance",
                "options": [
                    "light",
                    "dark"
                ],
                "default": "light"
            },
            {
                "key": "language",
                "type": "option",
                "label": "Default language",
                "options": [
                    "auto",
                    "en",
                    "zh-CN",
                    "zh-TW"
                ],
                "default": "zh-CN"
            },
            {
                "key": "statusCardsVisibility.clock",
                "type": "bool",
                "label": "Show system time",
                "default": true
            },
            {
                "key": "statusCardsVisibility.fleetKpi",
                "type": "bool",
                "label": "Show fleet KPI",
                "default": true
            },
            {
                "key": "statusCardsVisibility.alerts",
                "type": "bool",
                "label": "Show alerts",
                "default": true
            },
            {
                "key": "statusCardsVisibility.speedTrend",
                "type": "bool",
